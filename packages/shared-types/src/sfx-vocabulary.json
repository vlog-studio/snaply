    "crunch": { "file": "crunch-chips.mp3", "label": "바삭", "anchor": "action", "maxMs": 1000, "gainDb": -3, "evokedBy": { "objects": ["bread"] }, "keywords": ["과자", "감자칩", "크로플", "튀김", "바삭", "쿠키"] },
